+package qz.utils;
+
+import org.testng.annotations.Test;
+import java.util.*;
+
+import static org.testng.Assert.*;
+import static qz.utils.WindowsQueueUsbIdentity.*;
+
+/**
+ * TDD de la parte PURA del parche 0005 (identidad USB por cola en Windows).
+ *
+ * TODOS los fixtures son DATOS REALES, volcados del Windows del usuario el
+ * 2026-07-24 con `zq/dump-0005-win.ps1` (usuario NO admin, cero errores):
+ * ver `.memoria_tpv/deteccion-impresora/windows-cruce/dump-0005-win-2026-07-24.json`.
+ *
+ *   PortName  parent (DEVPKEY_Device_Parent)          cola(s)
+ *   USB001    USB\VID_04F9&PID_2042\000L6Z215703      ticketsraw, "Brother QL-700"  (DESENCHUFADA)
+ *   USB002    USB\VID_0416&PID_5011\Printer           "80"        (POS58, serie basura, ENCENDIDA)
+ *   USB003    USB\VID_1FC9&PID_2016\702D07693632      tickets     (POS-80, ENCENDIDA)
+ *   ESDPRT001 (no cuelga de usbprint)                 ticketepson, EPSON...ReceiptE4
+ */
+public class WindowsQueueUsbIdentityTest {
+
+    // ---- fixtures medidos ---------------------------------------------------
+    private static final String P_BROTHER = "USB\\VID_04F9&PID_2042\\000L6Z215703";
+    private static final String P_POS58   = "USB\\VID_0416&PID_5011\\Printer";
+    private static final String P_POS80   = "USB\\VID_1FC9&PID_2016\\702D07693632";
+
+    /** El bus REAL, tal cual lo devolvio Get-PnpDevice -PresentOnly.
+     *  OJO: la POS58 aparece en MAYUSCULAS (\PRINTER) y el registro dice \Printer. */
+    private Set<String> busReal() {
+        return new HashSet<>(Arrays.asList(
+                "USB\\VID_0416&PID_5011\\PRINTER",          // POS58 encendida (MAYUSCULAS)
+                "USB\\VID_1FC9&PID_2016\\702D07693632",     // POS-80 encendida
+                "USB\\VID_04B8&PID_0202\\J4FF025969",       // Epson (en bus, fuera de usbprint)
+                "USB\\VID_8087&PID_0A2B\\5&1AA452E9&0&7"    // ruido
+                // la Brother 04F9:2042 NO esta: desenchufada
+        ));
+    }
+
+    private Map<String,List<Nodo>> mapaReal() {
+        return indexarPorPuerto(Arrays.asList(
+                new Nodo("USB001", P_BROTHER),
+                new Nodo("USB002", P_POS58),
+                new Nodo("USB003", P_POS80)));
+    }
+
+    // ---- 1. los tres estados, sobre datos reales ---------------------------
+
+    @Test public void pos80_encendida_identificada_y_presente() {
+        Identidad id = resolver("USB003", mapaReal(), busReal());
+        assertEquals(id.estado, Estado.IDENTIFIED);
+        assertEquals(id.vendorId, "1fc9");
+        assertEquals(id.productId, "2016");
+        assertEquals(id.serial, "702D07693632");
+        assertTrue(id.serialUnica);
+        assertTrue(id.estaPresente());
+        assertEquals(id.devicePath,
+                "\\\\?\\USB#VID_1FC9&PID_2016#702D07693632#{28d78fad-5a12-11d1-ae5b-0000f803a8c2}");
+    }
+
+    /**
+     * PRUEBA ADVERSARIAL OBLIGATORIA — el detector de mentiras.
+     *
+     * La Brother esta DESENCHUFADA con 2 colas instaladas. El metodo DEBE darle
+     * identidad correcta Y marcarla AUSENTE. El codigo del BUG #33 la daba por
+     * presente y le entregaba su devicePath a la cola de la POS58.
+     */
+    @Test public void brother_desenchufada_identidad_correcta_pero_AUSENTE() {
+        Identidad id = resolver("USB001", mapaReal(), busReal());
+        assertEquals(id.estado, Estado.IDENTIFIED_ABSENT);
+        assertEquals(id.vendorId, "04f9");
+        assertEquals(id.productId, "2042");
+        assertEquals(id.serial, "000L6Z215703");
+        assertTrue(id.hayIdentidad(), "la identidad se conoce aunque este desenchufada");
+        assertFalse(id.estaPresente(), "MENTIRA: da por presente un aparato desenchufado");
+    }
+
+    /** La Epson va por driver propio (ESDPRT001): limitacion MEDIDA, congelada. */
+    @Test public void epson_esdprt_no_identificable() {
+        Identidad id = resolver("ESDPRT001", mapaReal(), busReal());
+        assertEquals(id.estado, Estado.NOT_IDENTIFIABLE);
+        assertFalse(id.hayIdentidad());
+        assertNull(id.vendorId);
+        assertNull(id.devicePath);
+    }
+
+    @Test public void print_to_pdf_no_identificable() {
+        assertEquals(resolver("PORTPROMPT:", mapaReal(), busReal()).estado, Estado.NOT_IDENTIFIABLE);
+    }
+
+    // ---- 2. el GOTCHA que habria roto la POS58 -----------------------------
+
+    /**
+     * El bus dice "\PRINTER" y el registro "\Printer". Con una comparacion
+     * sensible a mayusculas, la POS58 ENCENDIDA saldria AUSENTE y el TPV diria
+     * "impresora desconectada" con la impresora funcionando delante.
+     */
+    @Test public void pos58_presente_pese_a_diferir_en_mayusculas() {
+        Identidad id = resolver("USB002", mapaReal(), busReal());
+        assertEquals(id.estado, Estado.IDENTIFIED,
+                "el bus da \\PRINTER y el registro \\Printer: la comparacion debe ser case-insensitive");
+        assertTrue(id.estaPresente());
+        assertEquals(id.vendorId, "0416");
+    }
+
+    /** Serie basura ("Printer") NO impide identificar: el vinculo es topologico. */
+    @Test public void pos58_serie_basura_identifica_igual_pero_no_es_unica() {
+        Identidad id = resolver("USB002", mapaReal(), busReal());
+        assertTrue(id.hayIdentidad(), "una serie generica no puede impedir la identificacion");
+        assertEquals(id.serial, "Printer");
+        assertFalse(id.serialUnica, "'Printer' no distingue dos unidades del mismo modelo");
+    }
+
+    @Test public void series_basura_reconocidas() {
+        assertFalse(esSerieUnica("Printer"));
+        assertFalse(esSerieUnica("PRINTER"));
+        assertFalse(esSerieUnica("none"));
+        assertFalse(esSerieUnica("0"));
+        assertFalse(esSerieUnica(null));
+        assertFalse(esSerieUnica("ab"));                 // demasiado corta
+        assertTrue(esSerieUnica("702D07693632"));
+        assertTrue(esSerieUnica("000L6Z215703"));
+    }
+
+    // ---- 3. BUG #33: el puerto reutilizado ---------------------------------
+
+    /**
+     * El nucleo del BUG #33. Dos nodos declaran USB002; solo la POS58 esta en el
+     * bus. Se prueban las DOS ordenes: con "el primero gana" (codigo viejo) una
+     * de ellas devuelve el aparato ausente.
+     */
+    @Test public void puerto_reutilizado_gana_el_PRESENTE_en_cualquier_orden() {
+        for(boolean ausentePrimero : new boolean[]{ true, false }) {
+            List<Nodo> nodos = ausentePrimero
+                    ? Arrays.asList(new Nodo("USB002", P_BROTHER), new Nodo("USB002", P_POS58))
+                    : Arrays.asList(new Nodo("USB002", P_POS58), new Nodo("USB002", P_BROTHER));
+
+            Identidad id = resolver("USB002", indexarPorPuerto(nodos), busReal());
+            assertEquals(id.estado, Estado.IDENTIFIED);
+            assertEquals(id.vendorId, "0416",
+                    "BUG #33 (ausentePrimero=" + ausentePrimero + "): gano el aparato ausente");
+        }
+    }
+
+    /** Si NINGUNO esta presente, hay identidad pero AUSENTE. Nunca "presente". */
+    @Test public void puerto_reutilizado_todos_ausentes_no_inventa_presencia() {
+        Identidad id = resolver("USB002",
+                indexarPorPuerto(Arrays.asList(new Nodo("USB002", P_BROTHER))),
+                new HashSet<String>());   // bus vacio
+        assertEquals(id.estado, Estado.IDENTIFIED_ABSENT);
+        assertFalse(id.estaPresente());
+    }
+
+    // ---- 4. dos colas, un aparato -----------------------------------------
+
+    /** ticketsraw y "Brother QL-700" comparten USB001: ambas resuelven igual. */
+    @Test public void dos_colas_mismo_aparato_resuelven_por_cola() {
+        Map<String,List<Nodo>> mapa = mapaReal();
+        Identidad a = resolver("USB001", mapa, busReal());
+        Identidad b = resolver("USB001", mapa, busReal());
+        assertEquals(a.vendorId, b.vendorId);
+        assertEquals(a.estado, b.estado);
+        assertEquals(a.estado, Estado.IDENTIFIED_ABSENT);
+    }
+
+    // ---- 5. fail-safe: lo desconocido NUNCA se afirma ----------------------
+
+    /**
+     * Puerto que no esta en el indice (p.ej. un USB00N de un puerto nunca visto
+     * en este equipo). LIMITACION DOCUMENTADA: el portatil del usuario solo
+     * tiene 2 puertos, asi que el caso "puerto virgen" NO se pudo medir. El
+     * parche NO adivina: si el nodo no esta, es NOT_IDENTIFIABLE.
+     */
+    @Test public void puerto_desconocido_no_se_adivina() {
+        Identidad id = resolver("USB009", mapaReal(), busReal());
+        assertEquals(id.estado, Estado.NOT_IDENTIFIABLE);
+        assertNull(id.devicePath);
+    }
+
+    @Test public void entradas_nulas_no_revientan_ni_afirman() {
+        assertEquals(resolver(null, mapaReal(), busReal()).estado, Estado.NOT_IDENTIFIABLE);
+        assertEquals(resolver("USB003", null, busReal()).estado, Estado.NOT_IDENTIFIABLE);
+        // sin poder mirar el bus: identidad si, presencia NO
+        Identidad sinBus = resolver("USB003", mapaReal(), null);
+        assertEquals(sinBus.estado, Estado.IDENTIFIED_ABSENT);
+        assertFalse(sinBus.estaPresente(), "sin bus legible jamas se afirma presencia");
+    }
+
+    /** Un parent con formato inesperado no produce una identidad a medias. */
+    @Test public void parent_corrupto_no_produce_identidad_parcial() {
+        Map<String,List<Nodo>> mapa = indexarPorPuerto(Arrays.asList(
+                new Nodo("USB005", "BASURA\\NO_ES_UN_PARENT")));
+        Identidad id = resolver("USB005", mapa, busReal());
+        assertEquals(id.estado, Estado.NOT_IDENTIFIABLE);
+        assertNull(id.vendorId);
+        assertNull(id.devicePath);
+    }
+
+    @Test public void nodos_sin_puerto_se_omiten() {
+        Map<String,List<Nodo>> mapa = indexarPorPuerto(Arrays.asList(
+                new Nodo(null, P_POS80), new Nodo("", P_POS58)));
+        assertTrue(mapa.isEmpty());
+    }
+
+    // ---- 6. contrato de la parte IMPURA (fix medido en hardware 24-jul) -----
+
+    /**
+     * BUG DE HARDWARE cazado en vivo el 24-jul: leerParent usaba
+     * CM_Locate_DevNode con flag 0 (NORMAL), que SOLO localiza aparatos
+     * PRESENTES. Con la POS58 apagada y la Brother desenchufada, sus nodos no se
+     * encontraban y las colas salian NOT_IDENTIFIABLE en vez de IDENTIFIED_ABSENT
+     * -> se perdia la identidad justo cuando hace falta para avisar.
+     *
+     * La ejecucion real no es testeable sin Windows, pero SI se puede fijar el
+     * contrato: leerParent DEBE usar PHANTOM; estaVivoEnBus (presencia) NO.
+     * Es un gate: si alguien vuelve a poner flag 0 en leerParent, este test cae.
+     */
+    @Test public void leerParent_usa_PHANTOM_para_ver_aparatos_apagados() throws Exception {
+        String src = new String(java.nio.file.Files.readAllBytes(
+                java.nio.file.Paths.get("src/qz/utils/WindowsQueueUsbIdentity.java")), "UTF-8");
+
+        // Aislar el cuerpo de leerParent para no confundirlo con estaVivoEnBus.
+        int ini = src.indexOf("static String leerParent(");
+        int fin = src.indexOf("private static String leerCadena(");
+        assertTrue(ini > 0 && fin > ini, "no encuentro leerParent");
+        String cuerpo = src.substring(ini, fin);
+
+        assertTrue(cuerpo.contains("CM_LOCATE_DEVNODE_PHANTOM"),
+                "leerParent debe localizar el devnode con PHANTOM: si no, una impresora "
+                + "apagada no da identidad (NOT_IDENTIFIABLE en vez de IDENTIFIED_ABSENT).");
+        assertFalse(cuerpo.matches("(?s).*CM_Locate_DevNode\\([^,]+,[^,]+,\\s*0\\).*"),
+                "leerParent NO puede usar flag 0 (NORMAL): solo veria aparatos presentes.");
+    }
+
+    @Test public void estaVivoEnBus_usa_NORMAL_para_medir_presencia_real() throws Exception {
+        String src = new String(java.nio.file.Files.readAllBytes(
+                java.nio.file.Paths.get("src/qz/utils/WindowsQueueUsbIdentity.java")), "UTF-8");
+        int ini = src.indexOf("static boolean estaVivoEnBus(");
+        assertTrue(ini > 0, "no encuentro estaVivoEnBus");
+        String cuerpo = src.substring(ini);
+
+        // Presencia REAL: aqui SI queremos solo los presentes -> flag 0, NO phantom.
+        assertFalse(cuerpo.contains("CM_LOCATE_DEVNODE_PHANTOM"),
+                "estaVivoEnBus mide PRESENCIA: con PHANTOM daria por presente un aparato "
+                + "apagado y reapareceria el BUG #33 (identidad de un ausente como presente).");
+    }
+}
diff --git a/test/qz/utils/WindowsQueueIdentityBug33Test.java b/test/qz/utils/WindowsQueueIdentityBug33Test.java
new file mode 100644
index 0000000..6259d1a
--- /dev/null
+++ b/test/qz/utils/WindowsQueueIdentityBug33Test.java
@@ -0,0 +1,151 @@
+package qz.utils;
+
+import org.testng.annotations.Test;
+import java.io.*;
+import java.nio.file.*;
+import java.util.*;
+
+import static org.testng.Assert.*;
+
+/**
+ * BUG #33 — la cola de Windows declaraba la identidad USB de OTRA impresora.
+ *
+ * MEDIDO EN HARDWARE REAL (Windows 11 Pro 10.0.26200, 2026-07-22 y 2026-07-24):
+ * la Brother QL-700 DESENCHUFADA y la POS58 ENCENDIDA compartian puerto logico, y
+ * `printers.details()` emitia para la cola de la POS58 el vid/pid y el devicePath
+ * de la Brother ausente -> el TPV mandaba el ticket a una ruta que no existe.
+ *
+ * CAUSA RAIZ (leida en el codigo, no supuesta):
+ *   1. `WindowsUsbInfo.parse()` indexa por MODELO (out.put(vid+":"+pid, d)), no
+ *      por aparato ni por puerto.
+ *   2. `resolvePortToDevice()` recorre los valores y devuelve el PRIMERO cuyo
+ *      usbPort coincida -> con dos candidatos gana uno ARBITRARIAMENTE.
+ *   3. `DeviceInfo` no tiene concepto de presencia: no puede distinguir "esta en
+ *      el bus" de "su nodo sigue en el registro".
+ *
+ * ---------------------------------------------------------------------------
+ * ESTADO: CERRADO por el parche 0005.
+ * ---------------------------------------------------------------------------
+ * La via defectuosa NO se ha "arreglado": se ha SUSTITUIDO.
+ * `PrintServiceMatcher` ya no llama a `resolvePortToDevice`; ahora usa
+ * `WindowsQueueUsbIdentity`, que hace join EXPLICITO por
+ * `Device Parameters\PortName` y trata la presencia como pregunta separada.
+ *
+ * `WindowsUsbInfo.resolvePortToDevice` sigue existiendo (lo usa el enriquecido
+ * del listado de dispositivos del BUS, donde no hay cruce por puerto y por tanto
+ * no hay bug), pero YA NO decide a que aparato apunta una COLA.
+ *
+ * Por eso este fichero ya no reproduce el fallo — seria un rojo permanente sobre
+ * codigo que nadie ejecuta para esa pregunta. Es un GATE: falla si alguien
+ * vuelve a enchufar la via defectuosa a la emision de identidad por cola.
+ *
+ * Ver: .memoria_tpv/deteccion-impresora/windows-cruce/INFORME-cruce-cola-usb-windows-2026-07-24.md
+ */
+public class WindowsQueueIdentityBug33Test {
+
+    private String fuente(String ruta) throws IOException {
+        Path p = Paths.get(ruta);
+        assertTrue(Files.exists(p), "no encuentro " + ruta);
+        return new String(Files.readAllBytes(p), "UTF-8");
+    }
+
+    /**
+     * EL GATE. `PrintServiceMatcher` NO puede volver a resolver la identidad de
+     * una cola con `resolvePortToDevice`: esa funcion elige por orden de mapa y
+     * sin comprobar presencia.
+     */
+    @Test public void printservicematcher_no_usa_la_via_del_bug33() throws IOException {
+        String src = fuente("src/qz/printer/PrintServiceMatcher.java");
+
+        for(String linea : src.split("\n")) {
+            String l = linea.trim();
+            if(l.startsWith("//") || l.startsWith("*")) continue;   // comentarios: se permiten
+            assertFalse(l.contains("resolvePortToDevice"),
+                    "BUG #33 REINTRODUCIDO: PrintServiceMatcher vuelve a resolver la identidad "
+                    + "de la cola con resolvePortToDevice (elige por orden de HashMap y sin "
+                    + "comprobar presencia). Usa WindowsQueueUsbIdentity.resolver(). Linea: " + l);
+        }
+    }
+
+    /**
+     * La identidad y la presencia deben emitirse JUNTAS. Emitir vid/pid sin decir
+     * si el aparato esta en el bus es la mitad exacta del BUG #33.
+     */
+    @Test public void la_identidad_por_cola_se_emite_con_su_presencia() throws IOException {
+        String src = fuente("src/qz/printer/PrintServiceMatcher.java");
+
+        // OJO: buscar el TEXTO "usbPresent" en todo el fichero NO vale — aparece en
+        // comentarios y en la variable `usbPresentes`, asi que el gate sobrevivia a
+        // borrar la emision de verdad (mutante G2). Hay que exigir la SENTENCIA, y
+        // solo en lineas de codigo.
+        boolean emiteIdentidad = false, emitePresencia = false;
+        for(String linea : src.split("\n")) {
+            String l = linea.trim();
+            if(l.startsWith("//") || l.startsWith("*") || l.startsWith("/*")) continue;
+            if(l.contains("jsonService.put(\"vendorId\"")) emiteIdentidad = true;
+            if(l.contains("jsonService.put(\"usbPresent\"")) emitePresencia = true;
+        }
+
+        assertTrue(src.contains("WindowsQueueUsbIdentity"),
+                "la identidad por cola debe salir de WindowsQueueUsbIdentity (via 0005)");
+        assertTrue(emiteIdentidad, "no se emite vendorId por cola: ¿se retiro el parche 0005?");
+        assertTrue(emitePresencia,
+                "BUG #33: se emite identidad USB por cola SIN emitir su presencia "
+                + "(falta jsonService.put(\"usbPresent\", ...)). Un aparato ausente "
+                + "indistinguible de uno presente es el bug entero.");
+    }
+
+    /**
+     * Documenta POR QUE la via vieja no vale, ejecutandola. No es un rojo: es la
+     * prueba viva de que `resolvePortToDevice` elige arbitrariamente, y de que
+     * por eso no puede decidir sobre colas.
+     *
+     * Si algun dia esa funcion aprendiera a mirar la presencia, este test
+     * fallaria y habria que revisar el gate de arriba (podria dejar de hacer
+     * falta). Falla por MEJORA, nunca por regresion.
+     */
+    @Test public void via_vieja_sigue_eligiendo_a_ciegas_y_por_eso_esta_jubilada() {
+        WindowsUsbInfo.DeviceInfo pos58 = new WindowsUsbInfo.DeviceInfo();
+        pos58.vendorId = "0416"; pos58.productId = "5011"; pos58.usbPort = "USB002";
+        pos58.devicePath = WindowsUsbInfo.buildDevicePath("0416", "5011", "PRINTER");
+
+        WindowsUsbInfo.DeviceInfo brotherAusente = new WindowsUsbInfo.DeviceInfo();
+        brotherAusente.vendorId = "04f9"; brotherAusente.productId = "2042"; brotherAusente.usbPort = "USB002";
+        brotherAusente.devicePath = WindowsUsbInfo.buildDevicePath("04f9", "2042", "000L6Z215703");
+
+        // Mismo puerto, insercion con el ausente primero: gana el ausente.
+        Map<String,WindowsUsbInfo.DeviceInfo> info = new LinkedHashMap<>();
+        info.put("04f9:2042", brotherAusente);
+        info.put("0416:5011", pos58);
+
+        WindowsUsbInfo.DeviceInfo r = WindowsUsbInfo.resolvePortToDevice("USB002", info);
+        assertNotNull(r);
+        assertEquals(r.vendorId, "04f9",
+                "si esto cambia, resolvePortToDevice ya no elige a ciegas: revisa si el gate "
+                + "printservicematcher_no_usa_la_via_del_bug33 sigue siendo necesario");
+
+        // Y no hay forma de saber que ese ganador esta desenchufado.
+        boolean tieneCampoDePresencia = false;
+        for(java.lang.reflect.Field f : WindowsUsbInfo.DeviceInfo.class.getFields()) {
+            String n = f.getName().toLowerCase();
+            if(n.contains("present") || n.contains("here") || n.contains("absent")) tieneCampoDePresencia = true;
+        }
+        assertFalse(tieneCampoDePresencia,
+                "DeviceInfo ya sabe hablar de presencia: reevalua si sigue jubilada");
+    }
+
+    /** La via NUEVA, con el mismo escenario, acierta. Es el contraste directo. */
+    @Test public void via_nueva_acierta_en_el_mismo_escenario() {
+        Map<String,List<WindowsQueueUsbIdentity.Nodo>> mapa =
+                WindowsQueueUsbIdentity.indexarPorPuerto(Arrays.asList(
+                        new WindowsQueueUsbIdentity.Nodo("USB002", "USB\\VID_04F9&PID_2042\\000L6Z215703"),
+                        new WindowsQueueUsbIdentity.Nodo("USB002", "USB\\VID_0416&PID_5011\\Printer")));
+
+        Set<String> bus = new HashSet<>(Arrays.asList("USB\\VID_0416&PID_5011\\PRINTER"));
+
+        WindowsQueueUsbIdentity.Identidad id = WindowsQueueUsbIdentity.resolver("USB002", mapa, bus);
+        assertEquals(id.estado, WindowsQueueUsbIdentity.Estado.IDENTIFIED);
+        assertEquals(id.vendorId, "0416", "la via nueva debe elegir el aparato PRESENTE");
+        assertTrue(id.estaPresente());
+    }
+}
