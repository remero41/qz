diff --git a/src/qz/utils/WindowsQueueUsbIdentity.java b/src/qz/utils/WindowsQueueUsbIdentity.java
new file mode 100644
index 0000000..863981a
--- /dev/null
+++ b/src/qz/utils/WindowsQueueUsbIdentity.java
@@ -0,0 +1,387 @@
+package qz.utils;
+
+import java.util.*;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+/**
+ * Identidad USB de una COLA de impresion de Windows (parche 0005).
+ *
+ * Equivalente Windows del `usb://Printer/POS-80?serial=702D07693632` que en
+ * Linux (CUPS) viene dentro del `connection` de la cola. En Windows no existe
+ * ese campo: se reconstruye cruzando
+ *
+ *     cola.PortName (USB00N)
+ *        -> HKLM\SYSTEM\CurrentControlSet\Enum\USBPRINT\...\Device Parameters\PortName
+ *     nodo USBPRINT
+ *        -> DEVPKEY_Device_Parent
+ *     USB\VID_xxxx&PID_xxxx\<serie>
+ *
+ * MEDIDO EN HARDWARE REAL (Windows 11 Pro 10.0.26200, 2026-07-24, usuario NO
+ * administrador):
+ *
+ *   - `Device Parameters\PortName` y `DEVPKEY_Device_Parent` se leen SIN
+ *     privilegios de admin (cero errores en los 3 nodos del equipo). Importaba
+ *     comprobarlo: QZ corre como usuario normal y el parche 0001 ya fallo una
+ *     vez por permisos.
+ *   - El vinculo SOBREVIVE a cambiar la impresora de puerto USB fisico. Probado
+ *     INTERCAMBIANDO la POS-80 y la POS58 de puerto: sus ubicaciones fisicas se
+ *     permutaron y aun asi cada cola siguio apuntando a SU aparato. Si el
+ *     vinculo fuera posicional, las colas se habrian cruzado (= el ticket de la
+ *     venta saliendo por la impresora equivocada).
+ *
+ * ---------------------------------------------------------------------------
+ * POR QUE NO SE REUTILIZA `WindowsUsbInfo.resolvePortToDevice` (BUG #33)
+ * ---------------------------------------------------------------------------
+ * Aquella via MIENTE, y esta congelado en `WindowsQueueIdentityBug33Test`:
+ *
+ *   1. `WindowsUsbInfo.parse()` indexa el mapa por MODELO (vid:pid), no por
+ *      aparato ni por puerto.
+ *   2. `resolvePortToDevice()` RECORRE los valores y devuelve el PRIMERO cuyo
+ *      usbPort coincida -> con dos candidatos gana uno ARBITRARIAMENTE.
+ *   3. No existe ningun concepto de presencia: no puede distinguir "esta en el
+ *      bus" de "su nodo sigue en el registro".
+ *
+ * Resultado medido: la cola de la POS58 ENCENDIDA declaraba el devicePath de la
+ * Brother QL-700 DESENCHUFADA.
+ *
+ * Esta clase hace lo contrario: **join EXPLICITO por PortName** (no recorrido a
+ * ciegas) y **presencia como pregunta separada**, leida del bus vivo.
+ *
+ * ---------------------------------------------------------------------------
+ * TRES ESTADOS, NUNCA DOS
+ * ---------------------------------------------------------------------------
+ * Colapsar "no esta" en "no se sabe" (o al reves) es el antipatron rector de
+ * toda la campana. Por eso el resultado es un enum de tres valores y `valor` no
+ * se puede leer sin mirar `estado`:
+ *
+ *   IDENTIFIED        identidad conocida Y el aparato esta en el bus
+ *   IDENTIFIED_ABSENT identidad conocida, aparato NO presente (apagado/fuera)
+ *   NOT_IDENTIFIABLE  esta cola no cuelga de usbprint: no hay identidad por aqui
+ *
+ * Todo campo es ADITIVO: si no se puede resolver, NO se emite -> el TPV lo trata
+ * como indeterminado, que es como se comporta la flota con QZ sin parchear. La
+ * ausencia del dato NUNCA significa "no hay impresora".
+ */
+public class WindowsQueueUsbIdentity {
+    private static final Logger log = LogManager.getLogger(WindowsQueueUsbIdentity.class);
+
+    /** GUID_DEVINTERFACE_USBPRINT. */
+    public static final String USBPRINT_INTERFACE_GUID = "{28d78fad-5a12-11d1-ae5b-0000f803a8c2}";
+
+    /** DEVPKEY_Device_Parent: "USB\VID_1FC9&PID_2016\702D07693632" */
+    private static final Pattern PARENT =
+            Pattern.compile("USB\\\\VID_([0-9A-Fa-f]{4})&PID_([0-9A-Fa-f]{4})\\\\(.+)$");
+
+    /**
+     * Series genericas que NO identifican un aparato concreto. MEDIDO: la POS58
+     * del usuario declara literalmente "Printer".
+     *
+     * OJO — que la serie sea basura NO impide identificar la cola: Windows ata
+     * cola<->aparato por ParentIdPrefix (hash TOPOLOGICO por devnode), no por la
+     * serie. La POS58 se identifica perfectamente. Esto solo marca que la serie
+     * no sirve para distinguir DOS unidades del mismo modelo.
+     */
+    private static final Set<String> SERIE_BASURA = new HashSet<>(Arrays.asList(
+            "printer", "pos", "usb", "device", "serial", "none", "null", "unknown", "0", "000000"));
+
+    public enum Estado { IDENTIFIED, IDENTIFIED_ABSENT, NOT_IDENTIFIABLE }
+
+    /** Un nodo de Enum\USBPRINT ya leido: su PortName explicito y su parent crudo. */
+    public static class Nodo {
+        public final String portName;   // "USB003"
+        public final String parent;     // "USB\VID_1FC9&PID_2016\702D07693632"
+        public Nodo(String portName, String parent) {
+            this.portName = portName;
+            this.parent = parent;
+        }
+    }
+
+    /**
+     * Resultado. `vendorId`/`productId`/`serial`/`devicePath` SOLO son
+     * significativos si `estado != NOT_IDENTIFIABLE`; en ese caso son null.
+     */
+    public static class Identidad {
+        public final Estado estado;
+        public final String vendorId, productId, serial, devicePath;
+        public final boolean serialUnica;
+
+        private Identidad(Estado estado, String vid, String pid, String serial,
+                          String devicePath, boolean serialUnica) {
+            this.estado = estado;
+            this.vendorId = vid;
+            this.productId = pid;
+            this.serial = serial;
+            this.devicePath = devicePath;
+            this.serialUnica = serialUnica;
+        }
+
+        public static Identidad noIdentificable() {
+            return new Identidad(Estado.NOT_IDENTIFIABLE, null, null, null, null, false);
+        }
+
+        /** true solo si el aparato esta REALMENTE en el bus ahora. */
+        public boolean estaPresente() { return estado == Estado.IDENTIFIED; }
+
+        /** true si hay identidad, este o no presente el aparato. */
+        public boolean hayIdentidad() { return estado != Estado.NOT_IDENTIFIABLE; }
+    }
+
+    /** ¿La serie distingue dos unidades del mismo modelo? */
+    public static boolean esSerieUnica(String serial) {
+        if(serial == null) return false;
+        String s = serial.trim();
+        if(s.length() <= 2) return false;
+        return !SERIE_BASURA.contains(s.toLowerCase());
+    }
+
+    /**
+     * Construye el device path de interfaz usbprint.
+     * Formato medido: \\?\USB#VID_1FC9&PID_2016#702D07693632#{28d78fad-...}
+     */
+    public static String buildDevicePath(String vid, String pid, String serial) {
+        if(vid == null || pid == null || serial == null) return null;
+        return "\\\\?\\USB#VID_" + vid.toUpperCase() + "&PID_" + pid.toUpperCase()
+             + "#" + serial + "#" + USBPRINT_INTERFACE_GUID;
+    }
+
+    /**
+     * DECISION PURA — testeable sin Windows. Es el corazon del parche.
+     *
+     * @param portName   puerto de la cola ("USB003", "ESDPRT001", "PORTPROMPT:")
+     * @param porPuerto  indice PortName -> nodos. JOIN EXPLICITO: se busca la
+     *                   clave, NO se recorre el arbol adivinando (esa fue la
+     *                   causa del BUG #33).
+     * @param presentes  InstanceIds USB presentes AHORA en el bus.
+     * @return nunca null; NOT_IDENTIFIABLE si no hay nada que afirmar.
+     */
+    public static Identidad resolver(String portName,
+                                     Map<String,List<Nodo>> porPuerto,
+                                     Set<String> presentes) {
+        if(portName == null || porPuerto == null) return Identidad.noIdentificable();
+
+        List<Nodo> candidatos = porPuerto.get(portName);
+        if(candidatos == null || candidatos.isEmpty()) {
+            // La cola no cuelga de usbprint (Epson ESDPRT001, Print to PDF...).
+            // Es una limitacion MEDIDA, no un fallo.
+            return Identidad.noIdentificable();
+        }
+
+        // Con el puerto reutilizado por varios nodos, gana el que este PRESENTE.
+        // Nunca "el primero": eso es exactamente lo que hacia el codigo del BUG #33.
+        Nodo elegido = null;
+        boolean presente = false;
+        for(Nodo n : candidatos) {
+            if(n == null || n.parent == null) continue;
+            if(estaEnBus(n.parent, presentes)) { elegido = n; presente = true; break; }
+        }
+        if(elegido == null) {
+            for(Nodo n : candidatos) {
+                if(n != null && n.parent != null) { elegido = n; break; }
+            }
+        }
+        if(elegido == null) return Identidad.noIdentificable();
+
+        Matcher m = PARENT.matcher(elegido.parent);
+        if(!m.find()) return Identidad.noIdentificable();
+
+        String vid = m.group(1).toLowerCase();
+        String pid = m.group(2).toLowerCase();
+        String serial = m.group(3);
+
+        // Identidad conocida SIEMPRE; la presencia decide el estado, no si se emite.
+        // Un aparato apagado sigue teniendo identidad: negarla seria colapsar
+        // "no esta" en "no se sabe".
+        return new Identidad(
+                presente ? Estado.IDENTIFIED : Estado.IDENTIFIED_ABSENT,
+                vid, pid, serial,
+                buildDevicePath(vid, pid, serial),
+                esSerieUnica(serial));
+    }
+
+    /**
+     * ¿Esta este InstanceId en el bus?
+     *
+     * GOTCHA MEDIDO 2026-07-24: el bus devuelve la serie en MAYUSCULAS
+     * ("USB\VID_0416&PID_5011\PRINTER") y el registro en la caja original
+     * ("...\Printer"). Con `equals()` la POS58 ENCENDIDA saldria AUSENTE.
+     * La comparacion DEBE ser case-insensitive.
+     */
+    static boolean estaEnBus(String parent, Set<String> presentes) {
+        if(parent == null || presentes == null) return false;
+        String p = parent.toUpperCase();
+        for(String x : presentes) {
+            if(x != null && x.toUpperCase().equals(p)) return true;
+        }
+        return false;
+    }
+
+    /** Indexa nodos por PortName. Varias colas pueden compartir aparato y varios
+     *  nodos pueden declarar el mismo puerto: por eso el valor es una LISTA. */
+    public static Map<String,List<Nodo>> indexarPorPuerto(Collection<Nodo> nodos) {
+        Map<String,List<Nodo>> out = new HashMap<>();
+        if(nodos == null) return out;
+        for(Nodo n : nodos) {
+            if(n == null || n.portName == null || n.portName.trim().isEmpty()) continue;
+            List<Nodo> l = out.get(n.portName);
+            if(l == null) { l = new ArrayList<>(); out.put(n.portName, l); }
+            l.add(n);
+        }
+        return out;
+    }
+
+    // =======================================================================
+    //  LECTURA REAL — todo lo de aqui abajo va detras de isWindows() y es
+    //  fail-safe: ante cualquier error se devuelve vacio y NO se emite campo
+    //  (el TPV degrada a "indeterminado", jamas a "no hay impresora").
+    // =======================================================================
+
+    private static final String ENUM_USBPRINT = "SYSTEM\\CurrentControlSet\\Enum\\USBPRINT";
+
+    /**
+     * Lee Enum\USBPRINT y devuelve el indice PortName -> nodos.
+     *
+     * DIFERENCIA CLAVE CON `WindowsUsbInfo.readUsbprintPorts` (la del BUG #33):
+     * alli se derivaba el puerto del SUFIJO del nombre del nodo y se indexaba
+     * por ParentIdPrefix. Aqui se lee el valor EXPLICITO
+     * `Device Parameters\PortName`, que usbprint.sys graba a proposito, y se
+     * indexa POR PUERTO, que es la pregunta que hace la cola.
+     */
+    public static Map<String,List<Nodo>> leerNodos() {
+        if(!SystemUtilities.isWindows()) return Collections.emptyMap();
+        List<Nodo> nodos = new ArrayList<>();
+        try {
+            for(String modelo : com.sun.jna.platform.win32.Advapi32Util.registryGetKeys(
+                    com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, ENUM_USBPRINT)) {
+                String mbase = ENUM_USBPRINT + "\\" + modelo;
+                String[] hijos;
+                try {
+                    hijos = com.sun.jna.platform.win32.Advapi32Util.registryGetKeys(
+                            com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, mbase);
+                } catch(Exception e) {
+                    log.warn("0005: no puedo leer nodos de USBPRINT\\{}: {}", modelo, e.toString());
+                    continue;
+                }
+                for(String hijo : hijos) {
+                    String nodo = mbase + "\\" + hijo;
+                    String port = leerCadena(nodo + "\\Device Parameters", "PortName");
+                    if(port == null) continue;
+                    String parent = leerParent("USBPRINT\\" + modelo + "\\" + hijo);
+                    if(parent == null) continue;
+                    nodos.add(new Nodo(port, parent));
+                }
+            }
+        } catch(Throwable t) {
+            log.warn("0005: no puedo leer Enum\\USBPRINT (no se emitira identidad por cola): {}", t.toString());
+            return Collections.emptyMap();
+        }
+        Map<String,List<Nodo>> idx = indexarPorPuerto(nodos);
+        log.info("0005: {} nodo(s) usbprint indexados en {} puerto(s)", nodos.size(), idx.size());
+        return idx;
+    }
+
+    /** CM_LOCATE_DEVNODE_PHANTOM: localiza el devnode AUNQUE el aparato no este
+     *  presente en el bus (apagado/desenchufado). Sin esto, CM_Locate_DevNode con
+     *  flag 0 (NORMAL) solo ve los presentes, y una impresora apagada saldria
+     *  NOT_IDENTIFIABLE en vez de IDENTIFIED_ABSENT -> se perdia la identidad justo
+     *  cuando mas hace falta (avisar de que esta desconectada). MEDIDO 2026-07-24:
+     *  con la POS58 apagada y la Brother desenchufada, el flag 0 devolvia solo la
+     *  POS-80 encendida. */
+    static final int CM_LOCATE_DEVNODE_PHANTOM = 0x00000001;
+
+    /**
+     * DEVPKEY_Device_Parent del nodo. No lo expone Advapi32Util (no es un valor
+     * del registro sino una propiedad de PnP), asi que se va por SetupAPI:
+     * CM_Locate_DevNode(PHANTOM) + CM_Get_Parent + CM_Get_Device_ID.
+     *
+     * MEDIDO 2026-07-24 con usuario NO admin: se lee sin privilegios elevados.
+     * PHANTOM es imprescindible: el nodo USBPRINT existe en el registro aunque el
+     * aparato este apagado, pero CM_Locate_DevNode(NORMAL) no lo encontraria.
+     */
+    static String leerParent(String instanceId) {
+        try {
+            com.sun.jna.platform.win32.Cfgmgr32 cfg = com.sun.jna.platform.win32.Cfgmgr32.INSTANCE;
+            com.sun.jna.ptr.IntByReference devInst = new com.sun.jna.ptr.IntByReference();
+            if(cfg.CM_Locate_DevNode(devInst, instanceId, CM_LOCATE_DEVNODE_PHANTOM) != 0) return null;
+
+            com.sun.jna.ptr.IntByReference padre = new com.sun.jna.ptr.IntByReference();
+            if(cfg.CM_Get_Parent(padre, devInst.getValue(), 0) != 0) return null;
+
+            // CM_Get_Device_ID recibe un Pointer (firma real de JNA 5.17), no un
+            // char[]. Se pide primero el tamaño para no truncar IDs largos.
+            com.sun.jna.ptr.IntByReference tam = new com.sun.jna.ptr.IntByReference();
+            int bytes = (cfg.CM_Get_Device_ID_Size(tam, padre.getValue(), 0) == 0)
+                    ? (tam.getValue() + 1) * 2 : 1024;
+            com.sun.jna.Memory buf = new com.sun.jna.Memory(bytes);
+            if(cfg.CM_Get_Device_ID(padre.getValue(), buf, bytes, 0) != 0) return null;
+            String s = buf.getWideString(0);
+            return (s == null || s.trim().isEmpty()) ? null : s;
+        } catch(Throwable t) {
+            log.warn("0005: no puedo leer el parent de {}: {}", instanceId, t.toString());
+            return null;
+        }
+    }
+
+    private static String leerCadena(String clave, String valor) {
+        try {
+            if(!com.sun.jna.platform.win32.Advapi32Util.registryKeyExists(
+                    com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, clave)) return null;
+            if(!com.sun.jna.platform.win32.Advapi32Util.registryValueExists(
+                    com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, clave, valor)) return null;
+            String s = com.sun.jna.platform.win32.Advapi32Util.registryGetStringValue(
+                    com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, clave, valor);
+            return (s == null || s.trim().isEmpty()) ? null : s;
+        } catch(Exception e) {
+            return null;
+        }
+    }
+
+    /**
+     * InstanceIds USB presentes AHORA en el bus. Identidad y presencia son
+     * preguntas SEPARADAS: la identidad sale del registro (persiste con el
+     * aparato apagado), la presencia del bus vivo.
+     *
+     * Se reutiliza el listado USB que QZ ya sabe hacer; si no hay forma de
+     * mirarlo, se devuelve vacio -> todo saldra IDENTIFIED_ABSENT, nunca
+     * presente por omision.
+     */
+    public static Set<String> leerPresentes() {
+        if(!SystemUtilities.isWindows()) return Collections.emptySet();
+        Set<String> out = new HashSet<>();
+        try {
+            for(String vidpid : com.sun.jna.platform.win32.Advapi32Util.registryGetKeys(
+                    com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, "SYSTEM\\CurrentControlSet\\Enum\\USB")) {
+                String base = "SYSTEM\\CurrentControlSet\\Enum\\USB\\" + vidpid;
+                String[] insts;
+                try {
+                    insts = com.sun.jna.platform.win32.Advapi32Util.registryGetKeys(
+                            com.sun.jna.platform.win32.WinReg.HKEY_LOCAL_MACHINE, base);
+                } catch(Exception e) { continue; }
+                for(String inst : insts) {
+                    // Un devnode presente responde a CM_Locate_DevNode con flag
+                    // 0 (solo dispositivos PRESENTES). Los fantasmas del
+                    // registro fallan aqui: es justo la distincion que faltaba.
+                    String id = "USB\\" + vidpid + "\\" + inst;
+                    if(estaVivoEnBus(id)) out.add(id.toUpperCase());
+                }
+            }
+        } catch(Throwable t) {
+            log.warn("0005: no puedo leer la presencia del bus: {}", t.toString());
+            return Collections.emptySet();
+        }
+        return out;
+    }
+
+    /** CM_LOCATE_DEVNODE_NORMAL (0) solo localiza devnodes PRESENTES. */
+    static boolean estaVivoEnBus(String instanceId) {
+        try {
+            com.sun.jna.ptr.IntByReference devInst = new com.sun.jna.ptr.IntByReference();
+            return com.sun.jna.platform.win32.Cfgmgr32.INSTANCE
+                    .CM_Locate_DevNode(devInst, instanceId, 0) == 0;
+        } catch(Throwable t) {
+            return false;
+        }
+    }
+}
